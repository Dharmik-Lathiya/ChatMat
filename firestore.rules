rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- users -------------------------------------------------------
    // Any signed-in user may read basic profiles (search / participants).
    // Only the owner can create or edit their own profile document.
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // ---- notes: strictly private to the owner ----------------------
      match /notes/{noteId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId)
          && request.resource.data.title is string
          && request.resource.data.content is string;
        allow update, delete: if isSelf(userId);
      }
    }

    // ---- conversations ----------------------------------------------
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn()
          && request.auth.uid in resource.data.participantIds;
      }
      function participantIdsUnchanged() {
        return request.resource.data.participantIds
          == resource.data.participantIds;
      }

      // Creator must be a participant. Direct chats have exactly 2,
      // groups at least 2.
      allow create: if isSignedIn()
        && request.resource.data.type in ['direct', 'group']
        && request.resource.data.participantIds.size() >= 2
        && request.auth.uid in request.resource.data.participantIds;

      allow get, list: if isParticipant() || isAdmin();

      // Participants may update metadata (lastMessage, updatedAt,
      // readAt, group name) but never change the membership.
      allow update: if isParticipant() && participantIdsUnchanged();
      allow delete: if false;

      // ---- messages ---------------------------------------------------
      match /messages/{messageId} {
        function isMessageParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }

        allow read: if isMessageParticipant() || isAdmin();

        allow create: if isMessageParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000000;

        // Only the sender can edit (soft-delete) their own message.
        allow update: if isMessageParticipant()
          && resource.data.senderId == request.auth.uid;
        allow delete: if isMessageParticipant()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ---- public notes (shrib-style, no auth needed) ----
    match /sharedNotes/{noteId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /publicNotes/{slug} {
      allow read: if true;
      allow create: if true
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 1000000;
      allow update: if true
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 1000000;
      allow delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
